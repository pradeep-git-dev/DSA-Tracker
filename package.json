{
  "name": "dsa-mistake-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A secure MERN DSA mistake tracker with live LeetCode insights, revision planning, and adaptive recommendations.",
  "scripts": {
    "dev": "concurrently \"nodemon server/src/index.js\" \"vite --host 0.0.0.0\"",
    "server": "nodemon server/src/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/src/index.js",
    "check": "node --check server/src/index.js && node --check server/src/app.js && node --check server/src/services/leetcode.service.js && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.0.7"
  }
}
